# Backend Environment Variables
# =============================

# Database
DATABASE_URL=postgresql://skylark:password@localhost:5432/skylark_drones
REDIS_URL=redis://localhost:6379

# MQTT IoT
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Authentication
JWT_SECRET=your_secret_key_here_change_in_production
JWT_EXPIRY=7d

# Third-party APIs
MAPBOX_TOKEN=pk.your_mapbox_token_here
TWILIO_ACCOUNT_SID=AC_your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
EMAIL_SERVICE=sendgrid
SENDGRID_API_KEY=SG.your_api_key

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=https://your_key@sentry.io/project_id

# Backend Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Frontend Environment Variables
# ==============================

# API URLs
REACT_APP_API_URL=http://localhost:3000
REACT_APP_GRAPHQL_URL=http://localhost:3000/graphql

# Third-party
REACT_APP_MAPBOX_TOKEN=pk.eyJ1IjoiY291bnRzaWxvIiwiYSI6ImNqdjI5MW5mdTA4MTYzMW5xazZrYWdyaHoifQ.secret_key_here

# Frontend Server
REACT_APP_ENV=development

# Optional Analytics
REACT_APP_SENTRY_DSN=https://your_key@sentry.io/project_id
REACT_APP_GA_TRACKING_ID=UA-XXXXXXXXX-X
