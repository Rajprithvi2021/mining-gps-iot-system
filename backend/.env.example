DATABASE_URL=postgresql://user:password@localhost:5432/mining_iot
NODE_ENV=development
PORT=3000

# Mapbox API
MAPBOX_PUBLIC_KEY=pk.your_mapbox_public_key_here

# CORS
CORS_ORIGIN=http://localhost:3000

# API Security
API_KEY=your-secret-api-key-here

# Logging
LOG_LEVEL=info

# Database connection pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# Frontend URL
FRONTEND_URL=http://localhost:3000
