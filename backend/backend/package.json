{
  "name": "skylark-backend",
  "version": "1.0.0",
  "description": "Mining IoT system backend services",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
    "build": "tsc",
    "migrate": "ts-node scripts/migrate-db.ts",
    "seed": "ts-node scripts/seed-demo-data.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "mining",
    "iot",
    "gps",
    "tracking"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "@apollo/server": "^4.9.5",
    "graphql": "^16.8.0",
    "cors": "^2.8.5",
    "pg": "^8.11.0",
    "redis": "^4.6.11",
    "bull": "^4.11.4",
    "paho-mqtt": "^1.1.0",
    "winston": "^3.11.0",
    "joi": "^17.11.0",
    "express-rate-limit": "^7.1.0",
    "dot-env": "^0.0.1",
    "jsonwebtoken": "^9.1.2"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2"
  }
